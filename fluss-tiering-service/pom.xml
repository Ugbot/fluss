<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.fluss</groupId>
        <artifactId>fluss</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fluss-tiering-service</artifactId>
    <name>Apache Fluss (Incubating) : Tiering Service</name>

    <packaging>jar</packaging>

    <dependencies>
        <!-- the engine-agnostic tiering core that this daemon drives -->
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-lake-tiering-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-rpc</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            The concrete lake implementation is a runtime plugin loaded via the SPI /
            PluginManager from the plugins/ dir; it is provided + optional so it is absent from
            the compile classpath and from the daemon's own runtime classpath (it lives under
            plugins/ instead). This keeps the daemon engine-agnostic and Hadoop/Flink-free.
        -->
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-lake-iceberg</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Test-only dependencies for the end-to-end TieringServiceITCase. These exercise the
            standalone daemon against a real FlussClusterExtension cluster and a real Paimon lake
            (filesystem catalog). They are strictly test-scoped so the daemon's production /
            runtime classpath stays Flink- and Hadoop-free (enforced by the bannedDependencies
            rule above, which does not include test scope). The concrete lake (fluss-lake-paimon)
            is resolved by the daemon at runtime via the SPI ServiceLoader from the test classpath,
            mirroring the plugins/ directory layout used in production.
        -->
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-test-utils</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-server</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-server</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-common</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- the concrete lake the daemon tiers into during the ITCase (resolved via SPI) -->
        <dependency>
            <groupId>org.apache.fluss</groupId>
            <artifactId>fluss-lake-paimon</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-bundle</artifactId>
            <version>${paimon.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Arrow + paimon-arrow are needed at runtime when the reader writes Arrow batches to
             Paimon; fluss-lake-paimon marks them provided, so the test classpath supplies them. -->
        <dependency>
            <groupId>org.apache.paimon</groupId>
            <artifactId>paimon-arrow</artifactId>
            <version>${paimon.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>${arrow.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>${arrow.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.curator</groupId>
            <artifactId>curator-test</artifactId>
            <version>${curator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-flink-and-hadoop</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.flink:*</exclude>
                                        <exclude>org.apache.hadoop:*</exclude>
                                    </excludes>
                                    <message>The standalone tiering daemon must not depend on Flink
                                        or Hadoop. Lakes are loaded via SPI / PluginManager at
                                        runtime from the plugins/ directory.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Build a self-contained fat jar so the daemon can be dropped into the dist
                lib/ directory and launched directly. This mirrors the fluss-server shade
                execution: it shades in fluss-client, fluss-lake-tiering-core, fluss-common,
                fluss-rpc and their needed transitive deps (artifactSet *:*). The concrete
                lake implementation (fluss-lake-iceberg) is provided + optional, so it is NOT
                shaded here; it stays a runtime plugin loaded from the plugins/ directory.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-fluss</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>*:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.apache.commons</pattern>
                                    <shadedPattern>org.apache.fluss.shaded.org.apache.commons</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.roaringbitmap</pattern>
                                    <shadedPattern>org.apache.fluss.shaded.org.roaringbitmap</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
